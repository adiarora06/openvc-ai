ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300
MONTE_CARLO_SIMULATIONS=2000
SAMPLE_PATHS=20
