DEMO_MODE=true
LOG_LEVEL=INFO

# Use a pooled Postgres URL from Neon, Supabase, Railway, Render, or another host.
DATABASE_URL=

PRIMARY_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
